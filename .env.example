# Provider order: first successful provider wins.
MODEL_PROVIDER_ORDER=openai_compatible,gemini
MODEL_REQUEST_TIMEOUT_SECONDS=35

# Primary provider: any OpenAI-compatible multimodal endpoint.
# OpenRouter default base URL shown; replace for OpenAI, LM Studio, vLLM, etc.
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_VISION_MODEL=openai/gpt-4o-mini
OPENAI_COMPAT_TEXT_MODEL=openai/gpt-4o-mini
OPENAI_COMPAT_SITE_URL=https://slowskibhere.github.io/Omniguide/omniguide.html
OPENAI_COMPAT_APP_NAME=OmniGuide

# Optional fallback provider.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Deterministic by default; set to model only when desired.
INTENT_ROUTER_MODE=deterministic
ALLOWED_ORIGINS=https://slowskibhere.github.io,http://localhost:8000,http://127.0.0.1:8000
GCP_PROJECT_ID=omniguide-hackathon
